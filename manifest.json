{
    "manifest_version": 3,
    "name": "Ai-tab",
    "version": "1.0.1",
    "description": "根据网页标题和内容智能进行标签分组",
    "action": {
        "default_popup": "src/pages/popup/index.html",
        "default_title": "AI标签分组"
    },
    "options_page": "src/pages/options/index.html",
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "src/background/background.ts",
        "type": "module"
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "contextMenus",
        "storage",
        "scripting",
        "offscreen"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "vendor/transformers/*",
                "src/pages/offscreen/index.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
}