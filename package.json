{
  "name": "ai-tab-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "node scripts/copy-vendor.mjs && vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write --experimental-cli src/",
    "optimize": "vite optimize --force",
    "copy:vendor": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.1.8",
    "@langchain/openai": "^1.5.5",
    "@mozilla/readability": "^0.6.0",
    "@types/chrome": "^0.1.32",
    "linkedom": "^0.18.12",
    "pinia": "^3.0.4",
    "segmentit": "^2.0.3",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.5",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-oxlint": "~1.29.0",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.29.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-zip-pack": "^1.2.4",
    "vue-tsc": "^3.1.5"
  }
}